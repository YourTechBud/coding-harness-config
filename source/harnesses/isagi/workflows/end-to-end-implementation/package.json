{
  "name": "isagi-workflow-end-to-end-implementation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --log-override:unsupported-dynamic-import=error --outfile=dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "isagi-workflow-verify --workflow ."
  },
  "dependencies": {
    "@yourtechbudstudio/isagi-workflow-sdk": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
