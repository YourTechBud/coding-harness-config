    "esbuild": "0.28.0",
    "isagi-workflow-analyze-current-state": "link:../analyze-current-state",
    "isagi-workflow-common-graphs": "link:../../workflow-libraries/common-graphs",
    "isagi-workflow-design-architecture": "link:../design-architecture",
    "isagi-workflow-design-program": "link:../design-program",
    "isagi-workflow-implement-story": "link:../implement-story",
    "isagi-workflow-solution-walkthrough-story": "link:../solution-walkthrough-story",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.4.0"
}
